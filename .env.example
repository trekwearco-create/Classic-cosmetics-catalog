# Server only. Copy to .env.local and fill in yourself. Never commit .env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SITE_URL=
WHATSAPP_NUMBER=923222495034

# Cloudflare Turnstile (login bot check). The site key is public by design and
# is the only NEXT_PUBLIC_ variable allowed in this project.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis, for rate limiting. Optional; the site runs without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
